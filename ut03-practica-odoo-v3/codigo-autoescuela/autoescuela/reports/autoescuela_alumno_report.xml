<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción del informe: aparece en el menú ⚙ > Imprimir del formulario de alumno.
         Primero report_type = qweb-html (se ve en el navegador); después qweb-pdf (descarga el PDF) -->
    <record id="autoescuela_alumno_report_action" model="ir.actions.report">
        <field name="name">Informe de alumno</field>
        <field name="model">autoescuela.alumno</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">autoescuela.autoescuela_alumno_report_template</field>
        <field name="report_file">autoescuela.autoescuela_alumno_report_template</field>
        <field name="print_report_name">'Informe de alumno - %s' % object.name</field>
        <field name="binding_model_id" ref="model_autoescuela_alumno"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Plantilla QWeb: web.external_layout pone la cabecera con los datos de la empresa -->
    <template id="autoescuela_alumno_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="alumno">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 t-field="alumno.name"/>
                        <p>DNI: <span t-field="alumno.dni"/></p>
                        <p>Domicilio: <span t-field="alumno.domicilio"/></p>
                        <p>Matrícula: <span t-field="alumno.matricula"/></p>
                        <p>Autoescuela: <span t-field="alumno.autoescuela_id.name"/></p>
                        <p>Profesor: <span t-field="alumno.profesor_id.name"/></p>
                        <h5>Exámenes</h5>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Código</th><th>Fecha</th><th>Precio</th><th>Moneda</th>
                                    <th>Clases</th><th>Carnet</th><th>Aprobado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="alumno.examen_ids" t-as="examen">
                                    <td><span t-field="examen.name"/></td>
                                    <td><span t-field="examen.fecha"/></td>
                                    <td><span t-field="examen.precio"/></td>
                                    <td><span t-field="examen.moneda_id.name"/></td>
                                    <td><span t-field="examen.clases"/></td>
                                    <td><span t-field="examen.carnet"/></td>
                                    <td><t t-if="examen.aprobado">Sí</t><t t-else="">No</t></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
