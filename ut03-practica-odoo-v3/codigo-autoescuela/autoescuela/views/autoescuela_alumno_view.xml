<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista lista (tree) de alumnos -->
    <record id="autoescuela_alumno_view_tree" model="ir.ui.view">
        <field name="name">autoescuela.alumno.view.tree</field>
        <field name="model">autoescuela.alumno</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="dni"/>
                <field name="domicilio"/>
                <field name="matricula"/>
                <field name="autoescuela_id"/>
                <field name="profesor_id"/>
                <field name="examen_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <!-- Vista formulario de alumno -->
    <record id="autoescuela_alumno_view_form" model="ir.ui.view">
        <field name="name">autoescuela.alumno.view.form</field>
        <field name="model">autoescuela.alumno</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="INFORMACIÓN GENERAL">
                            <field name="name"/>
                            <field name="dni"/>
                            <field name="domicilio"/>
                            <field name="matricula"/>
                            <field name="autoescuela_id"/>
                            <field name="profesor_id"/>
                        </group>
                        <group>
                            <field name="examen_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de ventana: la usa el menú «Alumnos» -->
    <record id="autoescuela_alumno_action" model="ir.actions.act_window">
        <field name="name">Alumnos</field>
        <field name="res_model">autoescuela.alumno</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
