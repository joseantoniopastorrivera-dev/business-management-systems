<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista lista (tree) de profesores -->
    <record id="autoescuela_profesor_view_tree" model="ir.ui.view">
        <field name="name">autoescuela.profesor.view.tree</field>
        <field name="model">autoescuela.profesor</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="dni"/>
                <field name="coche"/>
                <field name="matricula"/>
                <field name="autoescuela_id"/>
                <field name="incorporacion"/>
                <field name="antiguedad"/>
                <field name="alumno_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <!-- Vista formulario de profesor -->
    <record id="autoescuela_profesor_view_form" model="ir.ui.view">
        <field name="name">autoescuela.profesor.view.form</field>
        <field name="model">autoescuela.profesor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="INFORMACIÓN GENERAL">
                            <field name="name"/>
                            <field name="dni"/>
                            <field name="coche"/>
                            <field name="matricula"/>
                            <field name="autoescuela_id"/>
                            <field name="incorporacion"/>
                            <field name="antiguedad"/>
                        </group>
                        <group>
                            <field name="alumno_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de ventana: la usa el menú «Profesores» -->
    <record id="autoescuela_profesor_action" model="ir.actions.act_window">
        <field name="name">Profesores</field>
        <field name="res_model">autoescuela.profesor</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
