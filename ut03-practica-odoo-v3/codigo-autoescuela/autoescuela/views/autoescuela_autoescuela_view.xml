<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista lista (tree) de autoescuelas -->
    <record id="autoescuela_autoescuela_view_tree" model="ir.ui.view">
        <field name="name">autoescuela.autoescuela.view.tree</field>
        <field name="model">autoescuela.autoescuela</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="domicilio"/>
                <field name="localidad"/>
                <field name="provincia"/>
                <field name="contacto"/>
                <field name="examen_ids" widget="many2many_tags"/>
                <field name="alumno_ids" widget="many2many_tags"/>
                <field name="profesor_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <!-- Vista formulario de autoescuela -->
    <record id="autoescuela_autoescuela_view_form" model="ir.ui.view">
        <field name="name">autoescuela.autoescuela.view.form</field>
        <field name="model">autoescuela.autoescuela</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="INFORMACIÓN GENERAL">
                            <field name="name"/>
                            <field name="domicilio"/>
                            <field name="localidad"/>
                            <field name="provincia"/>
                            <field name="contacto"/>
                        </group>
                        <group>
                            <field name="examen_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="alumno_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="profesor_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de ventana: la usa el menú «Autoescuelas» -->
    <record id="autoescuela_autoescuela_action" model="ir.actions.act_window">
        <field name="name">Autoescuelas</field>
        <field name="res_model">autoescuela.autoescuela</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
